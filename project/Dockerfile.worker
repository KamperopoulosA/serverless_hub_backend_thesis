FROM node:20-bookworm-slim AS tooling

RUN npm install -g serverless@3.40.0 serverless-google-cloudfunctions

FROM eclipse-temurin:17-jre

WORKDIR /app

COPY --from=tooling /usr/local /usr/local
COPY target/platform-selector-api-1.0.0.jar app.jar

ENV SPRING_PROFILES_ACTIVE=worker

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
